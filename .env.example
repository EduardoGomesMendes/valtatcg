# =========================================================
#  Copie este arquivo para ".env" e preencha.
#  O .env NUNCA vai para o Git (já está no .gitignore).
# =========================================================

# --- Painel ---
PORT=3300
# true se o painel estiver atrás de HTTPS (marca o cookie de sessão como Secure)
HTTPS=false

# --- Sessão (quanto tempo o usuário fica logado) ---
# O cookie de login é "de sessão": o navegador o apaga ao fechar, então
# reabrir o navegador exige login de novo.
#
# Só isso não basta: o Chrome, com "Continuar de onde você parou" ligado,
# RESTAURA cookies de sessão. Por isso existe o prazo abaixo, que é decidido
# aqui no servidor e não depende do navegador de ninguém.
#
# Minutos sem nenhuma atividade até a sessão morrer.
SESSAO_INATIVIDADE_MIN=30

# Teto absoluto, contado do login. Mesmo quem usa o dia inteiro entra de novo
# depois desse prazo. Limita o estrago de um token roubado.
SESSAO_HORAS=12

# Domínio do cookie de sessão. Deixe VAZIO (padrão seguro): o cookie fica
# preso ao endereço que respondeu.
COOKIE_DOMAIN=

# --- pokemontcg.io ---
# Opcional: sem chave a API funciona, só com um limite de requisições menor.
# Cadastro gratuito em https://pokemontcg.io/
POKEMONTCG_API_KEY=

# --- Assinatura ---
# Dias de uso grátis desde o cadastro, antes de exigir pagamento.
DIAS_DE_TESTE=7
# Valor do plano único, em reais.
PRECO_MENSAL=9.97

# --- Gateway de pagamento (Asaas) ---
# Deixe ASAAS_API_KEY vazio para liberar assinaturas na mão pela tela de admin.
#
# ambiente: sandbox (testes, dinheiro de mentira) | producao (cobra de verdade)
# As contas são separadas: a chave de sandbox NÃO funciona em produção.
ASAAS_AMBIENTE=sandbox

# Chave gerada no painel do Asaas: Configurações -> Integrações -> API
# NUNCA cole esta chave em chat, e-mail ou commit.
ASAAS_API_KEY=

# Segredo combinado com o Asaas, enviado por ele no header
# `asaas-access-token` de cada notificação. NUNCA reaproveite a chave da API
# aqui: este token trafega a cada evento, e quem o roubar não pode levar
# junto o acesso à conta do Asaas.
#   Gerar no servidor:  openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=


# --- E-mail (avisos ao administrador, decisão da loja, confirmação do responsável) ---
# Sem isto o sistema funciona, só não envia e-mail (os avisos ficam no painel).
# Hostinger: servidor smtp.hostinger.com, porta 465 com SSL.
# Conferir tudo depois com:  node scripts/testar-email.mjs seu@email.com
# NUNCA cole a senha em chat, e-mail ou commit.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SEGURO=sim
SMTP_USER=
SMTP_PASS=
# Como o remetente aparece, no formato:  ValtaTCG <nao-responda@seudominio.com.br>
EMAIL_REMETENTE=
# Endereço público: é de onde saem os links dos e-mails.
URL_PUBLICA=https://valtatcg.com.br

# --- Diagnóstico ---
LOG_LEVEL=info

# --- Cadastro por e-mail (o link do e-mail leva a criar a senha) ---
# Horas de validade do link, e-mails por endereço por dia, pedidos por IP por hora.
# Para testar no seu computador sem SMTP:  EMAIL_MODO=console  (o link aparece no log)
CADASTRO_VALIDADE_HORAS=24
CADASTRO_ENVIOS_POR_EMAIL_DIA=3
CADASTRO_PEDIDOS_POR_IP_HORA=8

# --- Backup diário (scripts/backup.mjs; instalar com scripts/instalar-backup.sh) ---
# E-mail que recebe o aviso se o backup falhar (precisa do SMTP acima). Sem isto, a falha só aparece no journalctl.
EMAIL_AVISO_DONO=
