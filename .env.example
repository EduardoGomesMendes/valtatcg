# =========================================================
#  Copie este arquivo para ".env" e preencha.
#  O .env NUNCA vai para o Git (já está no .gitignore).
# =========================================================

# --- Painel ---
PORT=3300
# true se o painel estiver atrás de HTTPS (marca o cookie de sessão como Secure)
HTTPS=false

# --- Sessão (quanto tempo o usuário fica logado) ---
# O cookie de login é "de sessão": o navegador o apaga ao fechar, então
# reabrir o navegador exige login de novo.
#
# Só isso não basta: o Chrome, com "Continuar de onde você parou" ligado,
# RESTAURA cookies de sessão. Por isso existe o prazo abaixo, que é decidido
# aqui no servidor e não depende do navegador de ninguém.
#
# Minutos sem nenhuma atividade até a sessão morrer.
SESSAO_INATIVIDADE_MIN=30

# Teto absoluto, contado do login. Mesmo quem usa o dia inteiro entra de novo
# depois desse prazo. Limita o estrago de um token roubado.
SESSAO_HORAS=12

# Domínio do cookie de sessão. Deixe VAZIO (padrão seguro): o cookie fica
# preso ao endereço que respondeu.
COOKIE_DOMAIN=

# --- pokemontcg.io ---
# Opcional: sem chave a API funciona, só com um limite de requisições menor.
# Cadastro gratuito em https://pokemontcg.io/
POKEMONTCG_API_KEY=

# --- Diagnóstico ---
LOG_LEVEL=info
